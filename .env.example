# ─── Database ────────────────────────────────────────────────────────────────
# Local dev (docker compose up -d): use credentials below
DATABASE_URL="postgresql://grc:grc@localhost:5434/grc"
# GCP staging (docker compose --profile gcp up -d): proxy runs on 5433
# DATABASE_URL="postgresql://grc:<password>@localhost:5433/grc"
# Matches Cloud SQL instance name from infra/modules/cloud-sql (staging): {project_id}-postgres-staging
# Confirm with: gcloud sql instances list --project=grcchanakya
CLOUD_SQL_CONNECTION_NAME="grcchanakya:us-central1:grcchanakya-postgres-staging"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── GCP ─────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID="grcchanakya"
GCP_REGION="us-central1"
GCS_BUCKET_NAME="grc-evidence-staging"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/sa-key.json"

# ─── Clerk (wired in Story 1.3) ──────────────────────────────────────────────
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# From Clerk Dashboard → API Keys → "Show JWT Public Key" (for networkless token verification)
CLERK_JWT_KEY="-----BEGIN RSA PUBLIC KEY-----..."
# From Clerk Dashboard → Webhooks → endpoint → Signing Secret (starts with whsec_)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# ─── API internal service auth (wired in Story 1.4) ──────────────────────────
API_SERVICE_ACCOUNT_TOKEN=""
INTERNAL_API_URL="http://localhost:3001"

# ─── Sentry (wired in Story 1.6) ─────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ─── Vertex AI / Claude (wired in packages/ai, Story 2.1) ────────────────────
VERTEX_AI_PROJECT=""
VERTEX_AI_LOCATION="us-central1"
# Set to "direct" to use Anthropic API directly instead of Vertex AI
ANTHROPIC_PROVIDER="vertex"
ANTHROPIC_API_KEY=""

# ─── App ports ────────────────────────────────────────────────────────────────
# apps/web  → 3000 (Next.js)
# apps/api  → 3001 (Fastify)
# apps/worker → 3002 (Cloud Tasks handler)
PORT=3001
LOG_LEVEL="info"
NODE_ENV="development"

# ─── Allowed origins (comma-separated) ───────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000"
