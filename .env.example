# ─── Database ────────────────────────────────────────────────────────────────
# Local dev (docker compose up -d): use credentials below
DATABASE_URL="postgresql://grc:grc@localhost:5434/grc"
# If tenant schemas were created before Story 2.1 fingerprint DDL, upgrade them:
#   pnpm --filter @grc/db db:migrate:tenant-fingerprint
# GCP staging (docker compose --profile gcp up -d): proxy runs on 5433
# DATABASE_URL="postgresql://grc:<password>@localhost:5433/grc"
# Matches Cloud SQL instance name from infra/modules/cloud-sql (staging): {project_id}-postgres-staging
# Confirm with: gcloud sql instances list --project=grcchanakya
CLOUD_SQL_CONNECTION_NAME="grcchanakya:us-central1:grcchanakya-postgres-staging"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── GCP ─────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID="grcchanakya"
GCP_REGION="us-central1"
# Evidence blobs (Story 4.1). Prefer GCS_EVIDENCE_BUCKET; falls back to GCS_BUCKET_NAME.
GCS_EVIDENCE_BUCKET=""
GCS_BUCKET_NAME="grc-evidence-staging"
# Local dev: leave both empty to use in-memory evidence storage (not for production).
# GCS / emulator: set STORAGE_EMULATOR_HOST when using the fake GCS server.
# STORAGE_EMULATOR_HOST="http://localhost:4443"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/sa-key.json"

# ─── Clerk (wired in Story 1.3) ──────────────────────────────────────────────
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# From Clerk Dashboard → API Keys → "Show JWT Public Key" (for networkless token verification)
CLERK_JWT_KEY="-----BEGIN RSA PUBLIC KEY-----..."
# From Clerk Dashboard → Webhooks → endpoint → Signing Secret (starts with whsec_)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# ─── Clerk routing (wired in Story 1.4) ──────────────────────────────────────
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ─── API internal service auth (wired in Story 1.4) ──────────────────────────
API_SERVICE_ACCOUNT_TOKEN=""
INTERNAL_API_URL="http://localhost:3001"

# ─── Sentry (wired in Story 1.6 API; apps/worker reports errors when set) ─────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ─── Vertex AI / Claude (wired in packages/ai, Story 2.1) ────────────────────
VERTEX_AI_PROJECT=""
VERTEX_AI_LOCATION="us-central1"
# Optional override for Claude publication IDs on Vertex (region-specific)
GRC_VERTEX_MODEL_FINGERPRINT="claude-opus-4-20250514@20250514"
# Set to "direct" to use Anthropic API directly instead of Vertex AI
ANTHROPIC_PROVIDER="vertex"
ANTHROPIC_API_KEY=""

# ─── Async worker + Cloud Tasks (Story 2.1) ───────────────────────────────────
WORKER_HTTP_URL="http://localhost:3002"
WORKER_PUSH_URL=""
WORKER_INVOCATION_SECRET=""
SKIP_CLOUD_TASKS="true"
CLOUD_TASKS_QUEUE=""
GCP_TASKS_LOCATION=""
CLOUD_TASKS_SA_EMAIL=""

# ─── App ports ────────────────────────────────────────────────────────────────
# apps/web  → 3000 (Next.js)
# apps/api  → 3001 (Fastify)
# apps/worker → 3002 (Cloud Tasks handler)
PORT=3001
LOG_LEVEL="info"
NODE_ENV="development"

# ─── Allowed origins (comma-separated) ───────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000"
