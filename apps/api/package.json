    "@google-cloud/tasks": "^6.2.2",
    "@grc/config": "workspace:*",
    "@grc/db": "workspace:*",
    "@grc/types": "workspace:*",
    "@sentry/node": "^10.51.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.0.0",
    "svix": "^1.92.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
